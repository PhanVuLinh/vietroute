# ==============================================================================
# VIETROUTE TMS / WMS - PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Sử dụng: Sao chép tệp này thành .env hoặc truyền vào CI/CD pipeline / Docker Swarm / K8s

# --------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL 15+)
# --------------------------------------------------
POSTGRES_USER=vietroute_admin
POSTGRES_PASSWORD=ChangeMe_SuperSecret_DBPassword_2026!
POSTGRES_DB=vietroute_prod
DATABASE_URL=postgresql://vietroute_admin:ChangeMe_SuperSecret_DBPassword_2026!@postgres:5432/vietroute_prod?schema=public

# --------------------------------------------------
# 2. REDIS CACHE & QUEUE
# --------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ChangeMe_SuperSecret_RedisPassword_2026!

# --------------------------------------------------
# 3. BACKEND APPLICATION CONFIG
# --------------------------------------------------
NODE_ENV=production
PORT=3001
JWT_SECRET=vietroute_jwt_enterprise_secret_key_minimum_32_characters_long_2026!
JWT_EXPIRATION=86400s

# Danh sách URL frontend được phép gọi API (phân cách bằng dấu phẩy)
CORS_ORIGIN=https://vietroute.vn,https://admin.vietroute.vn,http://localhost,http://localhost:80,http://localhost:3001

# --------------------------------------------------
# 4. FRONTEND APPLICATION CONFIG
# --------------------------------------------------
# Khi chạy thực tế trên production, đặt VITE_USE_MOCK=false để kết nối 100% database
VITE_USE_MOCK=false
VITE_API_BASE_URL=/api/v1
VITE_APP_TITLE=VietRoute TMS — Quản trị Logistics & Vận tải Thực tế
